# =========================================================================== #
# Multi-Source News Intelligence Platform - example environment file
#
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
# In `ENVIRONMENT=production` the application refuses to start with weak or
# default secrets (see app/core/config.py).
# =========================================================================== #

# --------------------------------------------------------------------------- #
# Runtime
# --------------------------------------------------------------------------- #
ENVIRONMENT=development           # development | staging | production | test
DEBUG=true
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=console                # console | json  (use json in production)
APP_NAME="News Intelligence Platform"
API_V1_PREFIX=/api/v1

# --------------------------------------------------------------------------- #
# Database
#   dev  : sqlite+aiosqlite:///./data/news.db
#   prod : postgresql+asyncpg://user:password@postgres:5432/newsdb
# --------------------------------------------------------------------------- #
DATABASE_URL=sqlite+aiosqlite:///./data/news.db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_ECHO=false

# --------------------------------------------------------------------------- #
# Redis (optional: an in-memory backend is used automatically when unset)
# --------------------------------------------------------------------------- #
REDIS_URL=
CACHE_TTL_SECONDS=60
CACHE_ENABLED=true

# --------------------------------------------------------------------------- #
# Security - generate with: python -c "import secrets;print(secrets.token_urlsafe(64))"
# --------------------------------------------------------------------------- #
JWT_SECRET_KEY=CHANGE_ME_generate_a_64_byte_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_MIN_LENGTH=12
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# Comma-separated. Use explicit origins in production, never "*" with credentials.
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
TRUSTED_HOSTS=*
MAX_REQUEST_BYTES=1048576         # 1 MiB request body cap
SECURE_HEADERS_ENABLED=true
HSTS_ENABLED=false                # enable only when served over HTTPS

# Rate limiting (token bucket, per client identity)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# First administrator, created by `news-platform init-db --with-admin`
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=

# --------------------------------------------------------------------------- #
# HTTP fetching / scraping
# --------------------------------------------------------------------------- #
HTTP_TIMEOUT_SECONDS=15
HTTP_MAX_RETRIES=3
HTTP_BACKOFF_BASE=0.5
HTTP_MAX_REDIRECTS=3
HTTP_MAX_RESPONSE_BYTES=5242880   # 5 MiB
HTTP_USER_AGENT="NewsIntelligenceBot/1.0 (+https://example.com/bot)"
HTTP_MAX_CONCURRENCY=8
RESPECT_ROBOTS_TXT=true
DEFAULT_REQUEST_DELAY_SECONDS=1.0

# SSRF protection: block private/loopback/link-local targets (keep true!)
SSRF_PROTECTION_ENABLED=true
ALLOWED_URL_SCHEMES=http,https
# Optional hostname allowlist (comma separated). Empty = allow any public host.
SOURCE_HOST_ALLOWLIST=

# --------------------------------------------------------------------------- #
# Source API credentials (never hard-code these in source files)
# --------------------------------------------------------------------------- #
NEWSAPI_KEY=
GDELT_ENABLED=true
SOURCES_CONFIG_PATH=configs/sources.yaml

# --------------------------------------------------------------------------- #
# Pipeline / intelligence tuning
# --------------------------------------------------------------------------- #
INGEST_BATCH_SIZE=100
DEDUP_TITLE_THRESHOLD=0.85
DEDUP_CONTENT_THRESHOLD=0.80
DEDUP_LOOKBACK_HOURS=72
TREND_WINDOW_HOURS=24
TREND_MIN_ARTICLES=3
EVENT_SIMILARITY_THRESHOLD=0.55
EVENT_WINDOW_HOURS=48
RETENTION_DAYS=90

# --------------------------------------------------------------------------- #
# Workers & scheduling (cron-like intervals in seconds)
# --------------------------------------------------------------------------- #
WORKER_CONCURRENCY=4
SCHEDULE_INGEST_SECONDS=300
SCHEDULE_PROCESS_SECONDS=900
SCHEDULE_TRENDS_SECONDS=1800
SCHEDULE_EVENTS_SECONDS=3600
SCHEDULE_CLEANUP_SECONDS=86400

# --------------------------------------------------------------------------- #
# Alerts
# --------------------------------------------------------------------------- #
ALERTS_ENABLED=true
ALERT_WEBHOOK_TIMEOUT_SECONDS=10
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=news-intel@example.com
SMTP_USE_TLS=true
