# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Environments & secrets
.env
.env.*
!.env.example
.venv/
venv/
env/
*.pem
*.key
secrets/

# Build artifacts
build/
dist/
*.egg-info/
.eggs/

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.mypy_cache/
.ruff_cache/

# Databases & data
*.db
*.sqlite
*.sqlite3
# Git cannot re-include a file whose parent directory is excluded, so the
# directory contents are ignored rather than the directory itself.
data/*
!data/.gitkeep

# Logs
*.log
logs/

# Editors / OS
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini
